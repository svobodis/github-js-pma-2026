<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Herní profil"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etNickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Zadej herní přezdívku"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHardcoreMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Zapnout Hardcore režim"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uložit (DataStore)"/>

        <!-- Načítací kolečko je defaultně neviditelné -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:visibility="invisible"/>

        <!-- Oddělovač -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:background="?android:attr/listDivider"/>

        <!-- Nový interaktivní prvek pro test plynulosti UI -->
        <TextView
            android:id="@+id/tvClickerCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Počet kliků během čekání: 0"
            android:textAlignment="center"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnClicker"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test plynulosti UI (Klikni!)"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>